import os
done = [i for i in ids if os.path.exists(f'/app/work/{i}/g2index_monoP_20.txt') and os.path.exists(f'/app/work/{i}/g2index_ortho_20.txt') and os.path.exists(f'/app/work/{i}/g2index_monoC_20.txt')]
