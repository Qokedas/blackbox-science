kill 1680: timeout --signal=TERM --kill-after=5s 60 bash -lc cd /app/work && ./killpy.sh batch_index.py; ./killpy.sh g2index.py; ./killpy.sh idx_test2; sleep 1; ls -d */g2index_monoP_20.txt | wc -l; python - <<'EOF'
