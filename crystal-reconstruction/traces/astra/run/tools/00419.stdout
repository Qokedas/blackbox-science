import os,sys,json,numpy as np
from scipy.ndimage import gaussian_filter1d
from scipy.signal import find_peaks,peak_widths
from scipy.optimize import least_squares
import matplotlib;matplotlib.use('Agg');import matplotlib.pyplot as plt
for sid in sys.argv[1:]:
 W='/app/work/'+sid;ins=json.load(open('/app/data/instances/'+sid+'/instrument.json'));rad=ins['radiation'];wl=rad['wavelength_A'];x,y,sig=np.loadtxt('/app/data/instances/'+sid+'/pattern.xye').T;dx=np.median(np.diff(x));noise=np.median(np.abs(np.diff(y,2)))/1.65
 ys=gaussian_filter1d(y,max(.65,.004*wl/1.54/dx));prom=max(noise*4,np.ptp(y)*.0025);idx,pp=find_peaks(ys,prominence=prom,distance=max(2,int(.025*wl/1.54/dx)))
 ww=peak_widths(ys,idx,rel_height=.5);wid=ww[0]*dx
 result=[]
 for k,i in enumerate(idx):
  if wid[k]>1.0*wl/1.54 or wid[k]<dx*1.2:continue
  if x[i]<x[0]+.05:continue
  half=max(wid[k]*1.7,dx*6);halfL=half;halfR=half
  if k>0:halfL=min(halfL,(x[i]-x[idx[k-1]])*.48)
  if k+1<len(idx):halfR=min(halfR,(x[idx[k+1]]-x[i])*.48)
  mask=(x>=x[i]-halfL)&(x<=x[i]+halfR);xx=x[mask];yy=y[mask];ss=np.maximum(sig[mask],noise)
  if len(xx)<6:continue
  double=len(rad.get('wavelengths_A') or [])>1
  ratio=rad['wavelengths_A'][1]/rad['wavelengths_A'][0] if double else 1.
  wt=(rad.get('wavelength_weights') or [1,.5])[1] if double else 0.
  wlft=max(dx,(i-ww[2][k])*2*dx);wrgt=max(dx,(ww[3][k]-i)*2*dx)
  def func(v):
   pos,h,w1,w2,eta,b,sl=v
   def peak(p):
    z=(xx-p)/np.where(xx<p,w1,w1 if double else w2)
    return ((1-eta)*np.exp(-4*np.log(2)*z*z)+eta/(1+4*z*z))
   pos2=np.rad2deg(2*np.arcsin(ratio*np.sin(np.deg2rad(pos/2))))
   return h*(peak(pos)+wt*peak(pos2))+b+sl*(xx-x[i])
  start=[x[i]-(np.rad2deg(2*np.arcsin(ratio*np.sin(np.deg2rad(x[i]/2))))-x[i])*wt/(1+wt),pp['prominences'][k],min(wlft,half*2),min(wrgt,half*2),.5,min(yy),0.]
  lower=[x[i]-max(dx*3,wid[k]*.5),0,dx*.5,dx*.5,0,min(yy)-np.ptp(yy),-np.inf]
  upper=[x[i]+max(dx*3,wid[k]*.5),np.ptp(yy)*4+pp['prominences'][k],max(wid[k]*4,dx*8),max(wid[k]*4,dx*8),1,max(yy),np.inf]
  try:
   fit=least_squares(lambda v:(func(v)-yy)/ss,start,bounds=(lower,upper),max_nfev=200)
   pos,h,w1,w2,eta,b,sl=fit.x;err=np.sqrt(max(0,np.linalg.pinv(fit.jac.T@fit.jac)[0,0]))*max(1,np.sqrt(np.mean(fit.fun**2)));rw=np.sqrt(np.mean(fit.fun**2))
  except:pos,h,w1,w2,eta,b,sl=start;err=dx;rw=0.
  if double:w2=w1
  if h<prom*.7:continue
  # eliminate a resolved Ka2 peak with its stronger matching Ka1 line
  if double:
   p1=np.rad2deg(2*np.arcsin(np.sin(np.deg2rad(pos/2))/ratio))
   if any(abs(z['two_theta']-p1)<max(dx*1.8,w1*.2) and .12<h/z['height']<.9 for z in result):continue
  result.append(dict(two_theta=float(pos),height=float(h),fwhm=float((w1+w2)/2),eta=float(eta),error=float(err),d=float(wl/(2*np.sin(np.deg2rad(pos/2)))),area=float(h*(w1+w2)/2),peak_max=float(x[i]),widthL=float(w1),widthR=float(w2),fit_chi=float(rw)))
 json.dump(result,open(W+'/peaks_raw.json','w'),indent=1)
 fig,axs=plt.subplots(2,1,figsize=(15,8));xxmax=min(x[-1],np.rad2deg(2*np.arcsin(wl*.18)))
 for ax in axs:ax.plot(x,y,lw=.6);ax.set_xlim(x[0],xxmax)
 axs[1].set_ylim(np.percentile(y,10)-noise, np.percentile(y,10)+.14*np.ptp(y))
 for j,z in enumerate(result):
  if z['two_theta']>xxmax:continue
  for ax in axs:
   ax.axvline(z['two_theta'],color='r',lw=.4);ax.text(z['two_theta'],np.interp(z['two_theta'],x,y),str(j+1),fontsize=7)
 axs[0].set_title(sid+' raw-maximum / asymmetric-profile peaks');fig.tight_layout();fig.savefig(W+'/peaks_raw.png',dpi=125);plt.close(fig)
 print(sid,len(result),[(j+1,round(z['two_theta'],4),round(z['height'])) for j,z in enumerate(result[:25])],flush=True)
