139:def get_loss(chi_2, restraint_penalty, loss, restraint_weight_type):
140:    """Calculate the loss function - what is actually optimised by pytorch
143:        chi_2 (Tensor): The chi2 for the current crystal structures
144:        restraint_penalty (Tensor): The penalty for restraints (if used) or 0
145:        loss (str): How to combine the chi2s and restraints to get a single
147:        restraint_weight_type (str): How to weight the restraint penalties
153:    # Need a function to convert all of the chi_2 values into a scalar
154:    if "chi2" in restraint_weight_type.lower():
155:        if "min" in restraint_weight_type.lower():
157:                chi2_no_grad = chi_2.min()
160:                chi2_no_grad = chi_2.clone().detach()
161:    if isinstance(loss, str):
162:        if loss.lower() == "sse":
163:            if restraint_weight_type == "constant":
164:                L = ((chi_2 + restraint_penalty)**2).sum()
166:                L = ((chi_2 + chi2_no_grad*restraint_penalty)**2).sum()
167:        elif loss.lower() == "sum":
168:            if restraint_weight_type == "constant":
169:                L = (chi_2 + restraint_penalty).sum()
171:                L = (chi_2 + chi2_no_grad*restraint_penalty).sum()
172:        elif loss.lower() == "xlogx":
173:            if restraint_weight_type == "constant":
174:                L = ((torch.log(chi_2)*chi_2) + restraint_penalty).sum()
176:                L = ((torch.log(chi_2)*chi_2) + chi2_no_grad*restraint_penalty).sum()
179:        if loss is None:
180:            # Default to the sum operation if loss is None
181:            if restraint_weight_type == "constant":
182:                L = (chi_2 + restraint_penalty).sum()
184:                L = (chi_2 + chi2_no_grad*restraint_penalty).sum()
187:                L = loss(chi_2, restraint_penalty)
190:                    L = loss(chi_2)
192:                    print("Unknown / incompatible loss function",loss)
214:        plot (bool, optional): Plot the curve of learning rate vs loss.
221:        tuple: Tuple containing the trial learning rate values, the losses
223:                associated with the minimum loss value multiplied by the
239:        lr_minimiser_settings["save_loss"] = True
242:        # Get the losses at each learning rate
245:        losses = result["losses"]
250:            plt.plot(trial_values, losses)
255:            minpoint = np.argmin(losses)
