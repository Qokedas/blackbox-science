PLANE_IDS=2,6,9,10,13,17,20,23 INDEX_TAG=emgaxis0 python /app/work/complete_mono_axis_emg.py X8a6f5a8 0 > /app/work/X8a6f5a8/index_emgaxis0.log 2>&1
