 if ndim==5:g[4]=x[3]*x[0]*x[2]
 if ndim==7:g[3]=x[3]*x[1]*x[2];g[4]=x[4]*x[0]*x[2];g[5]=x[5]*x[0]*x[1]
 return g
@njit(cache=False)
