143-      REAL*4 DTT(0:NPTS-1),PRFUNC(0:NPTS-1)
144-      REAL*4 DPRDT,SIGPART,GAMPART,SLPART,HLPART
145-      DO I=0,NPTS-1
146-        CALL PSVFCJO(DTT(I)*100.,TTHETA*100.,SIG,GAM,SPH/2.0,SPH/2.0,
147-     1     PRFUNC(I),DPRDT,SIGPART,GAMPART,SLPART,HLPART)
148-      END DO
149-      RETURN
150-      END
